#!/bin/bash

set -e
set -u

# --- Configuration ---
AGENT_REGISTRY_KEYS=("claude" "claude-code" "cursor" "opencode" "roo" "kilo" "windsurf" "warp" "zencoder" "codex" "gemini" "antigravity" "junie")
AGENT_REGISTRY_VALUES=(".claude/skills/" ".claude/skills/" ".cursor/rules/" ".opencode/skills/" ".roo/rules/" ".kilocode/rules/" ".windsurf/rules/" ".warp/rules/" ".zencoder/rules/" ".codex/skills/" ".gemini/skills/" ".agent.antigravity/skills/" ".junie/")

LOCAL_TRACKER_FILE=".ssf-agent-versions"
CONFIG_FILE=".ssf-agent-config"
REMOTE_BASE_URL="${AGENT_BOOT_REMOTE_URL:-https://raw.githubusercontent.com/SiereSoft/ssf-ai-skills-provider/develop/}"
VERSIONS_FILE="versions.json"

# --- Output Formatting ---
C_RESET='\033[0m'
C_RED='\033[31m'
C_GREEN='\033[32m'
C_CYAN='\033[36m'

log_info() { printf "${C_CYAN}|${C_RESET} %s\n" "$1"; }
log_success() { printf "${C_GREEN}|${C_RESET} %s\n" "$1"; }
log_error() { printf "${C_RED}|${C_RESET} %s\n" "$1" >&2; }

# --- Core Functions ---
get_agent_path() {
    local agent=$1
    for i in "${!AGENT_REGISTRY_KEYS[@]}"; do
        if [[ "${AGENT_REGISTRY_KEYS[$i]}" == "$agent" ]]; then
            printf "%s" "${AGENT_REGISTRY_VALUES[$i]}"
            return 0
        fi
    done
    return 1
}

print_usage() {
    local agents=""
    for agent in "${AGENT_REGISTRY_KEYS[@]}"; do
        agents+="$agent, "
    done
    agents=${agents%, }
    printf "Usage:\n"
    printf "  ./ssf-agent select                        (Configure your default AI agents)\n"
    printf "  ./ssf-agent download <skill> [--agent=]   (Download/update a skill)\n"
    printf "  ./ssf-agent update                        (Self-update the ssf-agent script)\n\n"
    printf "Supported Agents: %s\n" "$agents"
}

# --- Interactive TUI for Multi-Selection ---
interactive_multiselect() {
    local selected=()
    local cur=0
    local i

    # Initialize all as unselected (0)
    for i in "${!AGENT_REGISTRY_KEYS[@]}"; do selected[$i]=0; done

    printf "\nSelect your target AI agents (Use ARROW KEYS to move, SPACE to toggle, ENTER to confirm):\n\n" >&2

    # Hide cursor
    tput civis 2>/dev/null || true

    while true; do
        for i in "${!AGENT_REGISTRY_KEYS[@]}"; do
            local prefix="  "
            local box="[ ]"

            [ $i -eq $cur ] && prefix="> "
            [ ${selected[$i]} -eq 1 ] && box="[x]"

            printf "\033[K%s%s %s\n" "$prefix" "$box" "${AGENT_REGISTRY_KEYS[$i]}" >&2
        done

        IFS= read -rsn1 key

        if [[ "$key" == $'\x1b' ]]; then
            local seq
            IFS= read -rsn2 -t 1 seq || true
            if [[ "$seq" == "[A" ]]; then ((cur--)); fi
            if [[ "$seq" == "[B" ]]; then ((cur++)); fi
        elif [[ "$key" == " " ]]; then
            selected[$cur]=$((1 - selected[$cur]))
        elif [[ "$key" == "" ]]; then
            break
        fi

        [ $cur -lt 0 ] && cur=0
        [ $cur -ge ${#AGENT_REGISTRY_KEYS[@]} ] && cur=$((${#AGENT_REGISTRY_KEYS[@]}-1))

        printf "\033[%sA" "${#AGENT_REGISTRY_KEYS[@]}" >&2
    done

    tput cnorm 2>/dev/null || true

    local chosen=()
    for i in "${!AGENT_REGISTRY_KEYS[@]}"; do
        if [ ${selected[$i]} -eq 1 ]; then
            chosen+=("${AGENT_REGISTRY_KEYS[$i]}")
        fi
    done

    if [ ${#chosen[@]} -eq 0 ]; then
        log_error "No agents selected. Aborting."
        exit 1
    fi

    local IFS=','
    local result="${chosen[*]}"
    printf "%s" "$result"
}

save_config() {
    local chosen_agents="$1"
    echo "DEFAULT_AGENTS=\"$chosen_agents\"" > "$CONFIG_FILE"
    log_success "Saved agents to $CONFIG_FILE ($chosen_agents)"
}

get_configured_agents() {
    if [ -f "$CONFIG_FILE" ]; then
        grep "^DEFAULT_AGENTS=" "$CONFIG_FILE" | cut -d'"' -f2 || true
    else
        printf ""
    fi
}

version_gt() {
    [ "$1" = "$2" ] && return 1
    local IFS=.
    local i ver1 ver2
    ver1=($1)
    ver2=($2)
    for ((i=${#ver1[@]}; i<${#ver2[@]}; i++)); do ver1[i]=0; done
    for ((i=0; i<${#ver1[@]}; i++)); do
        if [[ -z ${ver2[i]:-} ]]; then ver2[i]=0; fi
        if ((10#${ver1[i]} > 10#${ver2[i]})); then return 0; fi
        if ((10#${ver1[i]} < 10#${ver2[i]})); then return 1; fi
    done
    return 1
}

check_dependencies() {
    if ! command -v curl &> /dev/null; then
        log_error "curl is not installed. Please install it to use ssf-agent."
        exit 1
    fi
}

handle_update() {
    log_info "Downloading latest ssf-agent script..."
    local script_url="${REMOTE_BASE_URL}ssf-agent"
    local temp_file="/tmp/ssf-agent-update.$$"

    if ! curl -sSfL --connect-timeout 5 "$script_url" -o "$temp_file" 2>/dev/null; then
        log_error "Failed to download update. Network unreachable or file missing."
        rm -f "$temp_file"
        exit 1
    fi

    # Verify it's actually a bash script to prevent replacing with a 404 page
    if ! head -n 1 "$temp_file" | grep -q "#!/bin/bash"; then
        log_error "Downloaded file is invalid. Update aborted."
        rm -f "$temp_file"
        exit 1
    fi

    # Safely determine where this script is currently running from
    local current_script_path
    if [[ "$0" == /* ]]; then
        current_script_path="$0"
    else
        current_script_path="$(command -v "$0")"
    fi

    if ! mv "$temp_file" "$current_script_path" 2>/dev/null; then
        log_error "Permission denied. Try running: sudo ssf-agent update"
        rm -f "$temp_file"
        exit 1
    fi

    chmod +x "$current_script_path"
    log_success "ssf-agent successfully updated to the latest version!"
}

handle_download() {
    if [[ -z "${1:-}" ]]; then
        print_usage
        exit 1
    fi
    local skill_name=$1
    local target_agents_str=""

    for arg in "$@"; do
        if [[ "$arg" == --agent=* ]]; then
            target_agents_str="${arg#--agent=}"
        fi
    done

    if [ -z "$target_agents_str" ]; then
        target_agents_str=$(get_configured_agents)

        if [ -z "$target_agents_str" ]; then
            log_info "No agents configured."
            target_agents_str=$(interactive_multiselect)
            save_config "$target_agents_str"
        fi
    fi

    local -a target_agents
    IFS=',' read -r -a target_agents <<< "$target_agents_str"

    log_info "Fetching remote registry..."
    local remote_registry
    remote_registry=$(curl -sSfL --connect-timeout 5 "$REMOTE_BASE_URL$VERSIONS_FILE" 2>/dev/null || true)

    if [[ -z "$remote_registry" ]]; then
        log_error "Network unreachable or file missing. Cannot fetch skills."
        exit 1
    fi

    local skill_block
    skill_block=$(printf "%s" "$remote_registry" | awk "/\"$skill_name\":/,/\}/")
    if [ -z "$skill_block" ]; then
        log_error "Skill '$skill_name' not found in repository."
        exit 1
    fi

    local remote_version
    remote_version=$(printf "%s" "$skill_block" | grep -o '"version": *"[^"]*"' | cut -d'"' -f4)
    local skill_file
    skill_file=$(printf "%s" "$skill_block" | grep -o '"file": *"[^"]*"' | cut -d'"' -f4)

    if [ -z "$remote_version" ] || [ -z "$skill_file" ]; then
         log_error "Skill '$skill_name' not found in repository."
         exit 1
    fi

    local current_local_version=""
    if [ -f "$LOCAL_TRACKER_FILE" ]; then
        current_local_version=$(grep "^$skill_name=" "$LOCAL_TRACKER_FILE" | cut -d'=' -f2 || true)
    fi

    if [ -n "$current_local_version" ]; then
        if ! version_gt "$remote_version" "$current_local_version"; then
            log_info "Skill '$skill_name' is already up to date (v$current_local_version)."
            return
        fi
    fi

    log_info "Downloading skill $skill_name (v$remote_version)..."
    local skill_content
    skill_content=$(curl -sSfL --connect-timeout 5 "${REMOTE_BASE_URL}skills/$skill_file" 2>/dev/null || true)
    if [ -z "$skill_content" ]; then
        log_error "Failed to download skill file '$skill_file'."
        exit 1
    fi

    local agent target_dir
    for agent in "${target_agents[@]}"; do
        agent=$(echo "$agent" | xargs)
        target_dir=$(get_agent_path "$(echo "$agent" | tr '[:upper:]' '[:lower:]')")

        if [ -z "$target_dir" ]; then
            log_error "WARNING: Unsupported agent '$agent'. Skipping."
            continue
        fi

        if ! mkdir -p "$target_dir" 2>/dev/null; then
            log_error "Insufficient directory permissions for $target_dir."
            exit 1
        fi

        if ! printf "%s\n" "$skill_content" > "$target_dir/$skill_file" 2>/dev/null; then
            log_error "Insufficient directory permissions for $target_dir."
            exit 1
        fi
        log_info " -> Placed in $target_dir"
    done

    touch "$LOCAL_TRACKER_FILE" 2>/dev/null || { log_error "Insufficient directory permissions."; exit 1; }
    grep -v "^$skill_name=" "$LOCAL_TRACKER_FILE" > "${LOCAL_TRACKER_FILE}.tmp" 2>/dev/null || true
    printf "%s=%s\n" "$skill_name" "$remote_version" >> "${LOCAL_TRACKER_FILE}.tmp"
    mv "${LOCAL_TRACKER_FILE}.tmp" "$LOCAL_TRACKER_FILE"

    local action="installed"
    [ -n "$current_local_version" ] && action="updated to"
    log_success "Skill '$skill_name' $action v$remote_version for $target_agents_str"
}

# Main Execution
check_dependencies

if [ $# -eq 0 ]; then
    print_usage
    exit 0
fi

SELECTED_AGENTS=""

case "$1" in
    select)
        SELECTED_AGENTS=$(interactive_multiselect)
        save_config "$SELECTED_AGENTS"
        ;;
    download)
        handle_download "${@:2}"
        ;;
    update)
        handle_update
        ;;
    *)
        printf "Unknown command: %s\n" "$1"
        print_usage
        exit 1
        ;;
esac